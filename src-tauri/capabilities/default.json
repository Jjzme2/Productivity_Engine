{
  "identifier": "default",
  "description": "Default capabilities for Productivity Engine",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "fs:allow-read",
      "allow": [{ "path": "$DOCUMENT/ProductivityEngine/Notes/**" }]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [{ "path": "$DOCUMENT/ProductivityEngine/Notes/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$DOCUMENT/ProductivityEngine" }, { "path": "$DOCUMENT/ProductivityEngine/Notes" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$DOCUMENT/ProductivityEngine" }, { "path": "$DOCUMENT/ProductivityEngine/Notes" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$DOCUMENT/ProductivityEngine/Notes" }]
    }
  ]
}
